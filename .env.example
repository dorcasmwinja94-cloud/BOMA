# Boma configuration — copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase PostgreSQL) ---
# Local / long-running server: the session pooler (port 5432) works with Prisma
# from most networks. Direct connections may be IPv6-only and unreachable.
# Vercel (many short-lived functions): use the transaction pooler (port 6543)
# with pgbouncer=true and connection_limit=1, and do NOT use a local
# sslrootcert path — that file does not exist in the serverless runtime.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to start if this is missing, "secret", or shorter than 32 chars.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Runtime ---
PORT=4000
# Public URL the SPA is reached at (used in CORS, confirmation/reset emails).
# In a single-project deployment the API also serves the built client; on Vercel
# this is the client project URL (comma-separated values are allowed).
CLIENT_URL="http://localhost:3000"
# Only needed if the DB connect must be retried before giving up (Supabase TLS flaps).
DB_CONNECT_ATTEMPTS=10
# Maximum accepted JSON request body. The API does not accept file uploads.
API_BODY_LIMIT="1mb"
# NODE_ENV=production serves client/build and enables trust-proxy + same-origin CORS.
NODE_ENV=development

# --- Google Sign-In (optional) ---
# OAuth 2.0 Web Application client ID from Google Cloud Console.
# Create it at: https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized JavaScript origins: https://boma-reservations.vercel.app
#     (plus http://localhost:3000 for local development)
# The SAME value goes in the client build as REACT_APP_GOOGLE_CLIENT_ID.
# Without it: the Google button stays hidden and /api/auth/google returns 503.
GOOGLE_CLIENT_ID=""

# --- Scheduled jobs (Vercel/external cron) ---
# Protects /api/cron/reminders and /api/cron/payments. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to disable both job endpoints (the local server keeps its timers).
CRON_SECRET=""

# --- Email (SMTP) ---
# Without SMTP_HOST every email is logged to the server console instead of being sent.
# Works with any SMTP provider (SendGrid, Mailgun, Gmail app-passwords, SES).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Boma <no-reply@example.com>"

# --- SMS (Africa's Talking) ---
# Without AT_API_KEY/AT_USERNAME every SMS is logged to the server console.
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# --- M-Pesa Daraja (Safaricom STK Push) ---
# Register at https://developer.safaricom.co.ke, create an app, then set the
# sandbox credentials and a public CALLBACK URL (e.g. via ngrok or your domain).
# Without ALL FIVE of these, initiating a payment is refused with HTTP 503 —
# the system never fabricates a completed payment.
# MPESA_ENVIRONMENT=production switches from sandbox to the live API.
# After editing, verify without charging anyone: npm run check:payments
# Production requires a stable public HTTPS callback (not a temporary tunnel),
# e.g. https://<your-api-project>.vercel.app/api/payments/mpesa/callback
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
MPESA_ENVIRONMENT="sandbox"
# CustomerPayBillOnline (default, for a Paybill) or CustomerBuyGoodsOnline (Till).
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# Percentage of the reservation total collected upfront (1–100). Default 100.
# Set e.g. 30 to take a 30% deposit and collect the balance at the property.
MPESA_DEPOSIT_PERCENT=100
