# Boma configuration — copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase PostgreSQL via the session pooler, port 5432) ---
# The session pooler works with Prisma from this network. Direct connections may
# be IPv6-only and unreachable. Port 6543 (transaction pooler) is not suitable
# for Prisma.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&sslrootcert=C:/path/to/certs/supabase-pooler-chain.pem"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Runtime ---
PORT=4000
# Public URL the SPA is reached at (used in confirmation/reset emails). In production
# the API serves the built client from the same origin; set this to the real domain.
CLIENT_URL="http://localhost:3000"
# Only needed if the DB connect must be retried before giving up (Supabase TLS flaps).
DB_CONNECT_ATTEMPTS=10
# NODE_ENV=production serves client/build and enables trust-proxy + same-origin CORS.
NODE_ENV=development

# --- Email (SMTP) ---
# Without SMTP_HOST every email is logged to the server console instead of being sent.
# Works with any SMTP provider (SendGrid, Mailgun, Gmail app-passwords, SES).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Boma <no-reply@example.com>"

# --- SMS (Africa's Talking) ---
# Without AT_API_KEY/AT_USERNAME every SMS is logged to the server console.
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# --- M-Pesa Daraja (Safaricom STK Push) ---
# Register at https://developer.safaricom.co.ke, create an app, then set the
# sandbox credentials and a public CALLBACK URL (e.g. via ngrok or your domain).
# Without ALL FIVE of these, initiating a payment is refused with HTTP 503 —
# the system never fabricates a completed payment.
# MPESA_ENVIRONMENT=production switches from sandbox to the live API.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
MPESA_ENVIRONMENT="sandbox"
# CustomerPayBillOnline (default, for a Paybill) or CustomerBuyGoodsOnline (Till).
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
# Percentage of the reservation total collected upfront (1–100). Default 100.
# Set e.g. 30 to take a 30% deposit and collect the balance at the property.
MPESA_DEPOSIT_PERCENT=100
