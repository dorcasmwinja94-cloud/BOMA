{
  "name": "Boma",
  "version": "1.0.0",
  "description": "Online Reservation Management System (Boma)",
  "scripts": {
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "ts-node server/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build:client": "npm run build --prefix client",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "ts-node --transpile-only server/index.ts --prod",
    "start:prod": "npm run build:server && node dist/server/index.js --prod",
    "typecheck": "tsc --noEmit",
    "check:payments": "ts-node --transpile-only server/scripts/checkPayments.ts",
    "check:go-live": "ts-node --transpile-only server/scripts/checkGoLive.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.5.0",
    "prisma": "^6.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.0.0",
    "postgres-memory-server": "^0.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
